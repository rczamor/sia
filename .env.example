# Database (Neon Postgres)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local dev: http://host.docker.internal:11434, VPS: http://localhost:11434)
OLLAMA_URL=http://host.docker.internal:11434

# Authentication
JWT_SECRET=change-this-to-a-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$...

# Langfuse (Phase 2)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# Publishing (Phase 2)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Feedly (Phase 1 optional)
# FEEDLY_ACCESS_TOKEN=
# FEEDLY_BOARD_ID=

# Webhooks
# N8N_WEBHOOK_SECRET=
