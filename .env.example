# Database — any Postgres with pgvector (production: Neon)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# LLM providers for internal context operations (classification, consolidation).
# Configure at least one; select per-operation via ai_config (provider: anthropic|openrouter).
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Embeddings — Ollama with nomic-embed-text
# (local dev: http://host.docker.internal:11434, VPS: http://localhost:11434)
OLLAMA_URL=http://host.docker.internal:11434

# Authentication — generate JWT_SECRET with: openssl rand -hex 32
# Generate ADMIN_PASSWORD_HASH with:
#   python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
JWT_SECRET=change-this-to-a-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Langfuse LLM observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# Feedly ingestion (optional)
# FEEDLY_ACCESS_TOKEN=
# FEEDLY_BOARD_ID=

# Generic ingestion webhook (optional): a shared secret that an automation
# platform (Zapier / n8n / Make) sends as the X-Sia-Webhook-Token header when it
# POSTs content to /api/ingest/webhook. Let the platform be the connector layer
# instead of building per-source integrations. Empty = endpoint disabled.
# INGEST_WEBHOOK_SECRET=

# HTTPS posture (defaults shown are production-safe): the session cookie is
# always Secure and HSTS is always sent. http://localhost still works in modern
# browsers; only disable these for plain-http dev on a NON-localhost host.
# See docs/deployment.md.
# SESSION_COOKIE_SECURE=true
# HSTS_ENABLED=true
# PUBLIC_BASE_URL=https://sia.example.com
# TRUSTED_PROXY_IPS=172.17.0.1   # exported to uvicorn as FORWARDED_ALLOW_IPS
