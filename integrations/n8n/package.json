{
  "name": "n8n-nodes-sia",
  "version": "0.1.0",
  "description": "n8n node that pushes content into Sia, a Context Engine, via its ingestion webhook",
  "keywords": ["n8n-community-node-package", "sia", "context-engine", "ingestion", "rag"],
  "license": "MIT",
  "homepage": "https://github.com/rczamor/sia",
  "repository": { "type": "git", "url": "https://github.com/rczamor/sia.git" },
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/SiaApi.credentials.js"],
    "nodes": ["dist/nodes/Sia/Sia.node.js"]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  }
}
